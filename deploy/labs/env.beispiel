# /opt/docker/pin-roboter/.env — nur für root lesbar (chmod 0600).
#
# Erzeugen der Geheimnisse:
#   DB_PASSWORD:          openssl rand -base64 24
#   GEHEIMNIS_SCHLUESSEL: openssl rand -base64 32
#   START_ADMIN_TOTP:     openssl rand -base64 20 | base32 | tr -d '=' | head -c 32

# Laufende Version — steuert das Image. Kein :latest.
VERSION=0.2.0

# Pflicht. Ohne sie bricht der Start ab.
DB_PASSWORD=
GEHEIMNIS_SCHLUESSEL=

# Optional, Vorgabe 2G. Budget des Fachprotokolls; ab 80 % rotiert es.
PROTOKOLL_BUDGET=2G

# Optional, Vorgabe "an". Mit "aus" laufen keine geplanten Sicherungen.
SICHERUNG_PLAN=an

# Erster Administrator (FA-BEN-035). Nur für die Erstinbetriebnahme, danach
# wieder entfernen. Ohne diese Angaben entsteht das Konto über die
# Ersteinrichtung im Browser — wer die Seite zuerst aufruft, wird Administrator.
# Auf einer aus dem Internet erreichbaren Instanz ist das ein Wettlauf;
# deshalb hier setzen und die Instanz erst danach im DNS veröffentlichen.
START_ADMIN_BENUTZER=
START_ADMIN_NAME=
# Passwort aus einer Datei lesen (Docker-Secret), nicht hier eintragen:
# erscheint sonst in "docker inspect" und in der Prozessliste.
START_ADMIN_PASSWORT_DATEI=
START_ADMIN_TOTP=
