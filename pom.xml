<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.pinroboter</groupId>
  <artifactId>pin-roboter</artifactId>
  <!-- BAUKLAMMER, keine Produktversion.

       Zentrale und Agent werden getrennt versioniert (ADR-0013): Am Agenten
       wird häufiger nachgearbeitet, weil die Erfahrung mit Kartenterminals und
       Konnektoren erst wächst. Eine gemeinsame Nummer zwänge dazu, die Zentrale
       mitzuziehen, obwohl sich dort nichts geändert hat — und ein Betreiber
       könnte aus der Nummer nicht ablesen, was er eigentlich bekommt.

       Diese Version hier ändert sich nur, wenn sich die Bau-Struktur ändert.
       Die Produktversionen stehen in src/zentrale/pom.xml und
       src/agent/pom.xml. -->
  <version>1</version>
  <packaging>pom</packaging>
  <name>PIN-Roboter</name>

  <modules>
    <module>src/gemeinsam</module>
    <module>src/simulator</module>
    <module>src/agent</module>
    <module>src/zentrale</module>
  </modules>

  <properties>
    <!-- Version der internen Bausteine (gemeinsam, simulator). Sie werden nicht
         ausgeliefert und folgen deshalb der Bauklammer. -->
    <bauklammer.version>1</bauklammer.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Versionen zentral festgeschrieben (NFA-BET-010, Reproduzierbarkeit) -->
    <bouncycastle.version>1.83</bouncycastle.version>
    <javalin.version>6.7.0</javalin.version>
    <slf4j.version>2.0.17</slf4j.version>
    <jackson.version>2.20.0</jackson.version>
    <sqlite.version>3.51.0.0</sqlite.version>
    <postgresql.version>42.7.9</postgresql.version>
    <junit.version>5.14.0</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BouncyCastle: sicherheitskritischste Abhaengigkeit, Version fest (ADR-0006) -->
      <dependency>
        <groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId><artifactId>bcutil-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId><artifactId>bcpkix-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId><artifactId>bctls-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>

      <dependency>
        <groupId>io.javalin</groupId><artifactId>javalin</artifactId>
        <version>${javalin.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId><artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version><scope>test</scope>
      </dependency>
      <dependency>
        <groupId>de.pinroboter</groupId><artifactId>gemeinsam</artifactId>
        <!-- Ausdrücklich die Bauklammer-Version, NICHT ${project.version}: Das
             löste sich im erbenden Modul zu dessen eigener Version auf, seit
             Zentrale und Agent verschiedene tragen. -->
        <version>${bauklammer.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
