# Vorlage für die Laborumgebung — als `.env` neben docker-compose.labor.yml
# ============================================================================
# Diese Datei gehört NICHT ins Repository, sobald echte Werte darin stehen.
# `.env` ist in .gitignore eingetragen; diese Vorlage bleibt.

# ── Pflicht ─────────────────────────────────────────────────────────────────

# Kennwort der Datenbank. Ohne diesen Wert startet der Stapel nicht.
#   openssl rand -base64 24
DB_PASSWORD=

# ── Dringend empfohlen ──────────────────────────────────────────────────────

# Verschlüsselt die hinterlegten Geräte-Zugangsdaten (FA-GER-010/020).
# Fehlt er, bleibt die Bestandserfassung nutzbar — Kennwörter lassen sich
# aber nicht speichern, und die Oberfläche sagt das.
#   openssl rand -base64 32
GEHEIMNIS_SCHLUESSEL=

# Schlüssel für die PIN-Ablage des Agenten (ADR-0009). Bewusst ein ANDERER
# als der obige: Wer den einen erbeutet, bekommt damit nicht auch den anderen.
# Fehlt er, bleiben hinterlegte PINs nur im Arbeitsspeicher und sind nach
# einem Neustart weg.
#   openssl rand -base64 32
PIN_ABLAGE_SCHLUESSEL=

# ── Erster Start ────────────────────────────────────────────────────────────

# Der erste Administrator (FA-BEN-035). Nur ausgewertet, wenn das Konto fehlt;
# ein vorhandenes wird nie verändert.
#
# NACH DEM ERSTEN START WIEDER ENTFERNEN. Wer diese Datei lesen kann, kennt
# sonst beide Faktoren — der zweite ist dann keiner mehr.
#
# TOTP-Geheimnis erzeugen:
#   openssl rand -base64 20 | base32 | tr -d '=' | head -c 32
START_ADMIN_BENUTZER=
START_ADMIN_NAME=
START_ADMIN_PASSWORT=
START_ADMIN_TOTP=

# Einmalig gültiges Geheimnis für die Registrierung des Agenten (FA-AGT-010).
# In der Oberfläche unter „Instanz → Standort-Agenten" erzeugen und hier
# eintragen. Nach der Registrierung kann die Zeile leer bleiben.
REGISTRIERUNG=

# ── Wahlfrei ────────────────────────────────────────────────────────────────

# Welche Fassung läuft. Ohne Angabe gilt der Vorgabewert aus der
# Compose-Datei. Kein `latest` — DevOps rollt ausdrücklich benannte
# Versionen aus.
#VERSION_ZENTRALE=0.4.0
#VERSION_AGENT=0.4.0
#VERSION_SIMULATOR=0.4.0

# Die drei Sicherungspläne aus FA-BAK-010 abschalten: `aus`
#SICHERUNG_PLAN=an
